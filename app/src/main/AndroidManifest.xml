<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只有这一条 queries：让"打开某个 App"的按钮能在 Android 11+ 找到启动入口 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- 注意：没有 INTERNET 权限，没有存储权限，没有短信/联系人/定位权限 -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- libxposed 的远程配置提供者：模块在输入法进程里靠它读到本 App 的设置 -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true" />

        <!-- 输入法进程靠它跨进程拉取当前配置（每次弹出键盘都会问一次，保证拿到最新值） -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="com.local.imebar.config"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
