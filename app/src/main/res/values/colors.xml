<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Design 3 色板（零依赖手写，固定蓝色系，基于 #0B57D0）。
  代码里只引用这里的语义名，不要散落字面色值。
-->
<resources>
    <!-- Primary：主按钮、Switch 打开、滑条 -->
    <color name="md_primary">#FF0B57D0</color>
    <color name="md_on_primary">#FFFFFFFF</color>
    <!-- 次按钮（tonal 容器） -->
    <color name="md_primary_container">#FFD3E3FD</color>
    <color name="md_on_primary_container">#FF041E49</color>

    <!-- Surface -->
    <color name="md_surface">#FFF9F9FF</color>
    <color name="md_surface_bright">#FFFFFFFF</color>
    <color name="md_surface_container">#FFEDEDF4</color>
    <color name="md_surface_container_high">#FFE7E8EE</color>
    <color name="md_on_surface">#FF191C20</color>
    <color name="md_on_surface_variant">#FF44474F</color>

    <!-- 描边 -->
    <color name="md_outline">#FF74777F</color>
    <color name="md_outline_variant">#FFC4C6D0</color>

    <!-- 状态层：主色 12% -->
    <color name="md_ripple_primary">#1F0B57D0</color>
</resources>
