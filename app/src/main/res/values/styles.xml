<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      没有 ActionBar：标题画在内容里，省掉一层系统栏（也顺手修掉"顶部文字被顶栏盖住"）。
      colorAccent / colorControlActivated 决定复选框的对勾和 SeekBar 的进度色——就是那两处浅绿。
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:colorControlActivated">@color/md_primary</item>
        <item name="android:colorControlHighlight">@color/md_ripple_primary</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
